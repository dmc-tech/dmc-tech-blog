---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from './Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { slugifyTag, type Post } from '../utils/posts';

type Props = CollectionEntry<'blog'>['data'] & {
  newer?: Post;
  older?: Post;
};

const { title, description, pubDate, updatedDate, heroImage, tags, newer, older } =
  Astro.props;
---

<Base title={title} description={description} image={heroImage?.src}>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <p class="dates">
        <FormattedDate date={pubDate} />
        {
          updatedDate && (
            <span class="updated">
              (updated <FormattedDate date={updatedDate} />)
            </span>
          )
        }
      </p>
    </header>
    {heroImage && <Image class="hero" src={heroImage} alt="" />}
    <div class="prose">
      <slot />
    </div>
    {
      tags.length > 0 && (
        <footer class="post-tags">
          {tags.map((t) => (
            <a class="tag" href={`/tags/${slugifyTag(t)}/`}>
              #{t}
            </a>
          ))}
        </footer>
      )
    }
  </article>

  {
    (newer || older) && (
      <nav class="post-nav" aria-label="More posts">
        {older ? (
          <a class="adj prev" href={`/blog/${older.id}/`}>
            <span class="dir">← Older</span>
            <span class="adj-title">{older.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {newer && (
          <a class="adj next" href={`/blog/${newer.id}/`}>
            <span class="dir">Newer →</span>
            <span class="adj-title">{newer.data.title}</span>
          </a>
        )}
      </nav>
    )
  }

  <p class="back"><a href="/blog">&larr; All posts</a></p>
</Base>

<style>
  .post-header {
    margin-bottom: 1.5rem;
  }
  .post-header h1 {
    margin-bottom: 0.5rem;
  }
  .dates {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0;
  }
  .updated {
    margin-left: 0.5rem;
  }
  .hero {
    width: 100%;
    margin: 1rem 0 2rem;
  }
  .post-tags {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tag {
    font-size: 0.85rem;
    color: var(--muted);
    text-decoration: none;
  }
  .tag:hover {
    color: var(--accent);
  }
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .adj {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    color: var(--fg);
  }
  .adj:hover {
    border-color: var(--accent);
  }
  .adj.next {
    text-align: right;
  }
  .dir {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .adj-title {
    font-weight: 600;
    line-height: 1.3;
  }
  .back {
    margin-top: 2.5rem;
  }
  @media (max-width: 520px) {
    .post-nav {
      grid-template-columns: 1fr;
    }
    .adj.next {
      text-align: left;
    }
  }
</style>
