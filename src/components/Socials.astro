---
import { SOCIALS } from '../consts';

interface Props {
  // 'row' = compact inline list (footer). 'list' = stacked (About page).
  layout?: 'row' | 'list';
  // Set false to render icons only (no text label).
  showLabels?: boolean;
}
const { layout = 'row', showLabels = true } = Astro.props;

// Hide any entry whose url hasn't been filled in yet.
const links = SOCIALS.filter((s) => s.url.trim() !== '');

const isExternal = (url: string) => /^https?:\/\//.test(url);

