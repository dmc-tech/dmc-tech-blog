---

{
  links.length > 0 && (
    <ul class:list={['socials', layout]}>
      {links.map((s) => (
        <li>
          <a
            href={s.url}
            rel={isExternal(s.url) ? 'me noopener noreferrer' : undefined}
            target={isExternal(s.url) ? '_blank' : undefined}
            aria-label={s.name}
          >
            {ICONS[s.name] && (
              <svg
                class="icon"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
                set:html={ICONS[s.name]}
              />
            )}
            {showLabels && <span>{s.name}</span>}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .socials {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 1rem;
  }
  .socials.row {
    flex-wrap: wrap;
    justify-content: center;
  }
  .socials.list {
    flex-direction: column;
    gap: 0.5rem;
  }
  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: inherit;
    text-decoration: none;
  }
  .socials a:hover {
    color: var(--accent);
  }
  .socials a:hover span {
    text-decoration: underline;
  }
  .icon {
    width: 1.15em;
    height: 1.15em;
    flex-shrink: 0;
  }
</style>
