---
import { getPosts, getArchive, getTags } from '../utils/posts';

const posts = await getPosts();
const archive = getArchive(posts);
const tags = getTags(posts);

const path = Astro.url.pathname;
const pad2 = (n: number) => String(n).padStart(2, '0');
---

<nav class="sidebar" aria-label="Browse posts">
  <section>
    <h2>Archive</h2>
    <ul class="years">
      {
        archive.map((y, i) => (
          <li>
            <details open={i === 0 || path.startsWith(`/blog/${y.year}`)}>
              <summary>
                <a href={`/blog/${y.year}/`}>{y.year}</a>
                <span class="count">{y.count}</span>
              </summary>
              <ul class="months">
                {y.months.map((m) => (
                  <li>
                    <a
                      href={`/blog/${y.year}/${pad2(m.month)}/`}
                      aria-current={
                        path.startsWith(`/blog/${y.year}/${pad2(m.month)}`)
                          ? 'page'
                          : undefined
                      }
                    >
                      {m.name}
                    </a>
                    <span class="count">{m.count}</span>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2><a href="/tags/">Tags</a></h2>
    {
      tags.length === 0 ? (
        <p class="count">No tags yet.</p>
      ) : (
        <ul class="tag-cloud">
          {tags.map((t) => (
            <li>
              <a
                href={`/tags/${t.slug}/`}
                aria-current={path === `/tags/${t.slug}/` ? 'page' : undefined}
              >
                {t.tag} <span class="count">{t.count}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</nav>

<style>
  .sidebar {
    font-size: 0.9rem;
  }
  .sidebar section {
    margin-bottom: 2rem;
  }
  .sidebar h2 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 0 0 0.75rem;
  }
  .sidebar h2 a {
    color: inherit;
    text-decoration: none;
  }
  .sidebar ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .years > li {
    margin-bottom: 0.35rem;
  }
  .years summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    list-style: none;
  }
  .years summary::-webkit-details-marker {
    display: none;
  }
  .years summary::before {
    content: '\25B8'; /* ▸ */
    color: var(--muted);
    font-size: 0.7rem;
  }
  .years details[open] > summary::before {
    content: '\25BE'; /* ▾ */
  }
  .years summary a {
    font-weight: 600;
    flex: 1;
  }
  .months {
    margin: 0.35rem 0 0.75rem 1.1rem;
  }
  .months li {
    display: flex;
    justify-content: space-between;
    padding: 0.15rem 0;
  }
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tag-cloud a {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
  }
  .tag-cloud a:hover,
  .tag-cloud a[aria-current='page'] {
    border-color: var(--accent);
    color: var(--accent);
  }
  .count {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    font-size: 0.8em;
  }
  .sidebar a[aria-current='page'] {
    font-weight: 700;
    color: var(--fg);
  }
</style>
