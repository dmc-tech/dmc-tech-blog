---
import Base from '../../layouts/Base.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getPosts, getTags } from '../../utils/posts';
import { SITE_TITLE } from '../../consts';

const tags = getTags(await getPosts());
---

<Base title={`Tags · ${SITE_TITLE}`} description="Browse posts by tag">
  <h1>Tags</h1>
  {
    tags.length === 0 ? (
      <p>No tags yet.</p>
    ) : (
      <ul class="all-tags">
        {tags.map((t) => (
          <li>
            <a href={`/tags/${t.slug}/`}>{t.tag}</a>
            <span class="count">
              {t.count} post{t.count === 1 ? '' : 's'}
            </span>
          </li>
        ))}
      </ul>
    )
  }
  <Sidebar slot="sidebar" />
</Base>

<style>
  .all-tags {
    list-style: none;
    padding: 0;
  }
  .all-tags li {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .count {
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
