---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import Sidebar from '../../../components/Sidebar.astro';
import { getPosts, getArchive, filterByDate } from '../../../utils/posts';
import { SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
  const archive = getArchive(await getPosts());
  return archive.map((y) => ({
    params: { year: String(y.year) },
    props: { year: y.year },
  }));
}

const { year } = Astro.props;
const posts = filterByDate(await getPosts(), year);
---

<Base title={`${year} · ${SITE_TITLE}`} description={`Posts from ${year}`}>
  <h1>Posts from {year}</h1>
  <p class="crumb"><a href="/blog/">All posts</a></p>
  <PostList posts={posts} empty={`No posts from ${year}.`} />
  <Sidebar slot="sidebar" />
</Base>

<style>
  .crumb {
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: -0.5rem;
  }
</style>
