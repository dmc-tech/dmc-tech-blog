---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Socials from '../components/Socials.astro';
import { SITE_TITLE, AUTHOR } from '../consts';
// Save the attached cartoon portrait to src/assets/danny-mcdermott.png
// (or .jpg — just match the extension here).
import portrait from '../assets/danny-mcdermott.png';
---

<Base title={`About · ${SITE_TITLE}`} description={`About ${AUTHOR}`}>
  <h1>About</h1>

  <div class="lead">
    <Image
      class="portrait"
      src={portrait}
      alt={`Stylised cartoon portrait of ${AUTHOR}`}
      width={320}
      height={320}
      densities={[1, 2]}
      loading="eager"
    />
    <div>
      <p>
        Hi, I'm {AUTHOR}. This is where I write down things I'd otherwise forget
        or think would be of interest to others.
      </p>
      <p>
        Posts are written in Markdown and published straight from a GitHub repo.
        The source for this site lives on GitHub; feel free to open an issue or
        PR if you spot a mistake.
      </p>
    </div>
  </div>

  <h2>Elsewhere</h2>
  <Socials layout="list" />
</Base>

<style>
  .lead {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }
  .portrait {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--code-bg);
  }
  .lead p:first-child {
    margin-top: 0;
  }
  @media (max-width: 520px) {
    .lead {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }
</style>
