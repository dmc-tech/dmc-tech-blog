---
import Base from '../layouts/Base.astro';
import Socials from '../components/Socials.astro';
import { SITE_TITLE, AUTHOR } from '../consts';
---

<Base title={`About · ${SITE_TITLE}`} description={`About ${AUTHOR}`}>
  <h1>About</h1>
  <p>
    Hi, I'm {AUTHOR}. This is where I write down things I'd otherwise forget o think would be of interest to others.
  </p>
  <p>
    Posts are written in Markdown and published straight from a GitHub repo. The
    source for this site lives on GitHub; feel free to open an issue or PR if you
    spot a mistake.
  </p>

  <h2>Elsewhere</h2>
  <Socials layout="list" />
</Base>
